[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Bix Granvik
	email = 229921352+BixGranvik253228@users.noreply.github.com
[init]
	defaultBranch = main
[fetch]
	prune = true
[alias]
    acp = "!f() { git add -A && git commit -m \"$@\" && git push; }; f"
[push]
	autoSetupRemote = true
