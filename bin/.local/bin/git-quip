#!/usr/bin/env zsh
# git quip "message"  ->  add -A, commit, push (setting upstream if needed)

emulate -L zsh

msg="$*"
if [[ -z "$msg" ]]; then
  print -u2 "quip: need a commit message"
  exit 1
fi

git rev-parse --is-inside-work-tree &>/dev/null || {
  print -u2 "quip: not inside a git repository"
  exit 1
}

git add -A || exit 1

if git diff --cached --quiet; then
  print "quip: nothing staged, skipping commit"
else
  git commit -m "$msg" || exit 1
fi

branch=$(git symbolic-ref --quiet --short HEAD) || {
  print -u2 "quip: detached HEAD, not pushing"
  exit 1
}

if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' &>/dev/null; then
  git push
else
  git remote get-url origin &>/dev/null || {
    print -u2 "quip: no 'origin' remote configured"
    exit 1
  }
  print "quip: setting upstream to origin/$branch"
  git push -u origin "$branch"
fi